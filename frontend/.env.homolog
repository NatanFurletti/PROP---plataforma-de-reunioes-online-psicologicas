# Usado no build da branch "homolog" na Vercel (vite build --mode homolog).
# Valores públicos — vão para o bundle.

# Vazio: a API é chamada no mesmo domínio (/api) e a Vercel repassa para o
# backend de homologação (ver vercel.json).
VITE_API_URL=

# O WebSocket da chamada vai direto ao backend de homologação no Render
VITE_SOCKET_URL=https://palas-api-homolog.onrender.com
