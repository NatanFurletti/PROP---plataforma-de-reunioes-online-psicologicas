# Usado no build de produção (Vercel). Valores públicos — vão para o bundle.

# Vazio: a API é chamada no mesmo domínio (/api) e a Vercel repassa para o
# backend (ver vercel.json). Assim o cookie de login continua first-party.
VITE_API_URL=

# O WebSocket da chamada vai direto ao backend no Render
VITE_SOCKET_URL=https://psiconnect-api.onrender.com
