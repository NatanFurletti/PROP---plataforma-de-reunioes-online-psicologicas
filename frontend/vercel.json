{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"homolog\" ]; then npm run build -- --mode homolog; else npm run build; fi",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "has": [{ "type": "host", "value": "prop-plataforma-de-reunioes-git-84ac90-natanfurlettis-projects\\.vercel\\.app" }],
      "destination": "https://palas-api-homolog.onrender.com/api/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://psiconnect-api.onrender.com/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
